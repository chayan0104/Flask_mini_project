@Library('mini-pipeline') _

pipeline {
  agent any

  parameters {
    choice(
      name: 'TARGET_ENV',
      choices: ['dev', 'uat'],
      description: 'Environment tag to publish for the container images'
    )
    string(
      name: 'AWS_REGION',
      defaultValue: 'us-east-1',
      description: 'AWS region containing the shared ECR repositories'
    )
  }

  environment {
    ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build images') {
      steps {
        miniPipeline([
          frontendContext: 'app/frontend',
          usersContext: 'app/users',
          ordersContext: 'app/orders',
          registry: env.ECR_REGISTRY,
          environment: params.TARGET_ENV,
          region: params.AWS_REGION
        ])
      }
    }
  }

  post {
    always {
      sh 'docker builder prune --filter until=24h -f || true'
    }
  }
}
